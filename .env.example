# Supabase — isi dari Project Settings > API (https://supabase.com/dashboard/project/llwikeclckwhsamenjmx/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://llwikeclckwhsamenjmx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=isi-publishable-key-di-sini

# Wajib (server saja, JANGAN diberi awalan NEXT_PUBLIC_):
# Secret key (sb_secret_...) atau service_role key dari Project Settings > API Keys
SUPABASE_SECRET_KEY=
# Kunci tanda tangan sesi login, minimal 32 karakter acak. Buat dengan: openssl rand -base64 48
AUTH_SECRET=

# Opsional: OpenAI untuk fitur Review Kualitas (AI) pada lembar Kesiapan
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

